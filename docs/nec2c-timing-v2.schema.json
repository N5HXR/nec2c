{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/konradkarczewski/nec2c-n5hxr/blob/master/docs/nec2c-timing-v2.schema.json",
  "title": "nec2c timing artifact version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "producer", "input", "dense_backend", "fft_backend", "clock", "completion", "process", "phases"],
  "properties": {
    "schema": { "const": "nec2c-timing" },
    "schema_version": { "const": 2 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "program_version"],
      "properties": {
        "program": { "const": "nec2c-n5hxr" },
        "program_version": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deck"],
      "properties": { "deck": { "type": "string" } }
    },
    "dense_backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "used"],
      "properties": {
        "requested": { "type": ["string", "null"], "enum": ["auto", "builtin", "lapack", null] },
        "used": { "type": ["string", "null"], "enum": ["builtin", "lapack", "mixed", null] }
      }
    },
    "fft_backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "used"],
      "properties": {
        "requested": { "type": ["string", "null"], "enum": ["auto", "builtin", "fftw", null] },
        "used": { "type": ["string", "null"], "enum": ["builtin", "fftw", "mixed", null] }
      }
    },
    "concurrency": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["jobs_requested", "threads_requested", "jobs_used", "threads_per_job", "allowed_cpus", "memory_limited"],
      "properties": {
        "jobs_requested": { "enum": ["auto", "explicit"] },
        "threads_requested": { "enum": ["auto", "explicit"] },
        "jobs_used": { "type": "integer", "minimum": 1 },
        "threads_per_job": { "type": "integer", "minimum": 1 },
        "allowed_cpus": { "type": "integer", "minimum": 1 },
        "memory_limited": { "type": "boolean" }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall", "cpu"],
      "properties": {
        "wall": { "const": "monotonic" },
        "cpu": { "const": "process" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "enum": ["ok", "error"] } }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "cpu_seconds", "peak_rss_kib"],
      "properties": {
        "wall_seconds": { "type": "number", "minimum": 0 },
        "cpu_seconds": { "type": "number", "minimum": 0 },
        "peak_rss_kib": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "seconds", "calls"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "seconds": { "type": "number", "minimum": 0 },
          "calls": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
